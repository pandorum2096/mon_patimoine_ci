# Copiez ce fichier en .env pour le développement local
# Ne committez JAMAIS le fichier .env sur GitHub

# URL PostgreSQL (Neon, Supabase, Render, ou local)
DATABASE_URL=postgresql://user:password@host:5432/patrimoine

# Clé secrète JWT (générez une clé aléatoire forte)
SECRET_KEY=changez-cette-cle-en-production-avec-une-valeur-aleatoire-longue

# Environnement
FLASK_ENV=development

# Port (Render l'injecte automatiquement)
PORT=5000
